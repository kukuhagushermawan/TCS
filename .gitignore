# Claude Code / AI tool local state - never commit this
.claude/

# Python virtual environment
.venv/
venv/
env/

# Python bytecode/cache
__pycache__/
*.pyc
*.pyo

# PyInstaller build output (regenerated by REBUILD_EXE*.bat)
build/TerraView/
build/TerraViewLite/
dist/

# Final installers/portable zips (regenerated by BUILD_APP_INSTALLER*.bat /
# MAKE_PORTABLE_ZIP_SMALL.bat) - distribute these via GitHub Releases
# instead of committing them to the repo; they are large binaries.
release/

# SR2 model file - too large for git (~64MB) and downloaded on demand via
# DOWNLOAD_SR2_MODEL.bat / the in-app SR2 optional runtime download.
assets/models/*.pth

# Editor/OS junk
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local test/scratch output
output/
